# Cloudinary (cloud name "ejf" — same account website2 uses)
CLOUDINARY_CLOUD_NAME=ejf
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shared password for the /upload page (basic auth, any username works)
UPLOAD_PASSWORD=

# Optional, defaults to 8417
PORT=8417

# Bearer token for the posting API (/api/post). 32+ chars; unset = API fails closed.
POST_TOKEN=

# Where the live (non-archive) manifest lives. Keep it OUTSIDE the repo in production
# (the deploy runs git reset --hard). Default: ./data/live/now.json
LIVE_MANIFEST=

# Public origin for feeds + og tags
SITE_URL=https://417am.party
